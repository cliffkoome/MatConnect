# Copy to .env (read by Next.js, the Prisma CLI and scripts) and fill in. Never commit the real file.
# `neon env pull` (or `neon deploy` / `neon checkout <branch>`) writes the DATABASE_URL*, NEON_BRANCH
# and NEON_AUTH_* values for the checked-out Neon branch. Required: DATABASE_URL, NEON_AUTH_BASE_URL
# and NEON_AUTH_COOKIE_SECRET; everything else degrades gracefully.

# --- Neon (written by the Neon CLI) -------------------------------------------------------------------
# Pooled URL (host contains "-pooler"): the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct URL: the Prisma CLI (migrations need a direct session). DIRECT_URL, if set, wins over it.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=dev
# Neon Auth (Managed Better Auth) for that branch.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Only needed for `prisma migrate dev` / drift checks when you can't let Prisma create one
# (e.g. a dedicated Neon branch such as "shadow").
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-shadow.REGION.aws.neon.tech/neondb?sslmode=require"
# Driver: "neon" (serverless driver, default for *.neon.tech) or "pg" (node-postgres, default otherwise).
# DATABASE_DRIVER=neon

# --- Auth (app config) ------------------------------------------------------------------------------
# Signs Neon Auth's cached session cookie. 32+ characters; not written by the Neon CLI. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=""
# Public origin of the app. Add it to Neon Auth's trusted domains for production:
#   neon neon-auth domain add https://your-app.example.com   (localhost is trusted by default)
APP_URL="http://localhost:3000"
# IANA time zone that decides which calendar day a trip or kilometre is counted under.
APP_TIME_ZONE="Africa/Nairobi"

# --- Integrations -----------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""

# Firebase Realtime Database (GPS ingestion). base64 of the service-account JSON:
#   base64 -w0 firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=""
FIREBASE_DATABASE_URL="https://matatu-eta-default-rtdb.europe-west1.firebasedatabase.app/"

# Africa's Talking SMS ("sandbox" uses the sandbox API)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME="sandbox"

# --- Background ETA cycle ------------------------------------------------------------------------------
# interval: run every 30 s inside `next start` (default when not on Vercel)
# cron:     a scheduler calls /api/cron/eta-cycle (default on Vercel, see vercel.json)
# off:      disabled (e.g. when running `npm run eta:worker` separately)
# ETA_CYCLE_MODE=interval
# Required for /api/cron/eta-cycle (Vercel sends it as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=""

# --- Development seed (optional) -----------------------------------------------------------------------
# `npm run db:seed` creates one user per role with these emails; sign up with one to get that role.
# SEED_ADMIN_EMAIL=you+admin@gmail.com
# SEED_MATADMIN_EMAIL=you+owner@gmail.com
# SEED_PASSENGER_EMAIL=you+passenger@gmail.com
