# Copy to .env (read by Next.js, the Prisma CLI and scripts) and fill in. Never commit the real file.
# Only DATABASE_URL, DIRECT_URL and the two JWT secrets are required; everything else degrades gracefully.

# --- Database: Neon Postgres --------------------------------------------------------------------
# Neon console → Connect → enable "Connection pooling" for the pooled URL (host contains "-pooler").
# The app uses the pooled URL at runtime; migrations use the direct (unpooled) one.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Only needed for `prisma migrate dev` / drift checks when you can't let Prisma create one
# (e.g. a dedicated Neon branch such as "shadow").
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@ep-shadow.REGION.aws.neon.tech/neondb?sslmode=require"
# Driver: "neon" (serverless driver, default for *.neon.tech) or "pg" (node-postgres, default otherwise).
# DATABASE_DRIVER=neon

# Public base URL (used for Google OAuth callback and password-reset links)
APP_URL="http://localhost:3000"

# --- Auth ------------------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Google OAuth 2.0 (authorised redirect URI: ${APP_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Integrations -----------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""

# Firebase Realtime Database (GPS ingestion). base64 of the service-account JSON:
#   base64 -w0 firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=""
FIREBASE_DATABASE_URL="https://matatu-eta-default-rtdb.europe-west1.firebasedatabase.app/"

# Africa's Talking SMS ("sandbox" uses the sandbox API)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME="sandbox"

# SMTP for password-reset emails (without these, dev uses an Ethereal test inbox)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# --- Background ETA cycle ------------------------------------------------------------------------------
# interval: run every 30 s inside `next start` (default when not on Vercel)
# cron:     a scheduler calls /api/cron/eta-cycle (default on Vercel, see vercel.json)
# off:      disabled (e.g. when running `npm run eta:worker` separately)
# ETA_CYCLE_MODE=interval
# Required for /api/cron/eta-cycle (Vercel sends it as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=""
