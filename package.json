{
  "name": "matconnect",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time matatu arrival times from live GPS, SMS arrival alerts, and fleet dashboards for operators (Next.js, Neon Postgres, Neon Auth)",
  "license": "ISC",
  "author": "Clifford Karani (https://github.com/cliffkoome)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliffkoome/MatConnect.git"
  },
  "homepage": "https://github.com/cliffkoome/MatConnect#readme",
  "bugs": {
    "url": "https://github.com/cliffkoome/MatConnect/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check": "node scripts/check-migrations.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "eta:worker": "tsx --conditions=react-server scripts/eta-worker.ts"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chart.js": "^4.5.1",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^5.1.1"
  }
}
